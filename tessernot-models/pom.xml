<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.kamilkrzywanski</groupId>
        <artifactId>tessernot-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>tessernot-models</artifactId>
    <!-- Its own version, released with a tag models-v<version>; see tessernot.models.version in the parent. -->
    <version>0.1.0</version>
    <name>tessernot-models</name>
    <description>The default tessernot models (PP-OCRv5 detection and angle classifier, PP-OCRv6 small
        recognition), found on the class path by OcrConfig.defaults().</description>

    <dependencies>
        <dependency>
            <!-- For the ModelBundle interface only: whoever uses the models has the engine already. -->
            <groupId>io.github.kamilkrzywanski</groupId>
            <artifactId>tessernot</artifactId>
            <version>${project.parent.version}</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>${project.basedir}/src/main/resources</directory>
            </resource>
            <resource>
                <directory>${repository.root}</directory>
                <targetPath>META-INF</targetPath>
                <includes>
                    <include>LICENSE</include>
                    <include>NOTICE</include>
                </includes>
            </resource>
            <resource>
                <directory>${repository.root}/models</directory>
                <targetPath>META-INF/models</targetPath>
                <includes>
                    <include>NOTICE</include>
                </includes>
            </resource>
            <resource>
                <directory>${repository.root}/models</directory>
                <targetPath>io/github/kamilkrzywanski/ocr/models</targetPath>
                <includes>
                    <include>ch_PP-OCRv5_det_mobile.onnx</include>
                    <include>PP-OCRv6_rec_small.onnx</include>
                    <include>ch_PP-LCNet_x0_25_textline_ori_cls_mobile.onnx</include>
                    <include>ppocrv6_dict.txt</include>
                </includes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifestEntries>
                            <Automatic-Module-Name>io.github.kamilkrzywanski.ocr.models</Automatic-Module-Name>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
            <plugin>
                <!-- The published POM has no parent and no dependencies: the JAR is data that the
                     engine finds on the class path, so it does not pin an engine version, and its
                     parent at a SNAPSHOT version would not resolve. -->
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
                <configuration>
                    <flattenMode>ossrh</flattenMode>
                    <updatePomFile>true</updatePomFile>
                    <pomElements>
                        <dependencies>remove</dependencies>
                    </pomElements>
                </configuration>
                <executions>
                    <execution>
                        <id>flatten</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>flatten</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>flatten-clean</id>
                        <phase>clean</phase>
                        <goals>
                            <goal>clean</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>

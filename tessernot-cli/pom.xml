<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.kamilkrzywanski</groupId>
        <artifactId>tessernot-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>tessernot-cli</artifactId>
    <name>tessernot-cli</name>
    <description>Command line for tessernot: one runnable JAR with the engine, PDF input and both model
        bundles.</description>

    <dependencies>
        <dependency>
            <groupId>io.github.kamilkrzywanski</groupId>
            <artifactId>tessernot-pdf</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.kamilkrzywanski</groupId>
            <artifactId>tessernot-models</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.kamilkrzywanski</groupId>
            <artifactId>tessernot-models-pl</artifactId>
        </dependency>
    </dependencies>

    <build>
        <!-- target/tessernot-cli.jar whatever the version, so ocr.sh and the docs need no version. -->
        <finalName>tessernot-cli</finalName>
        <plugins>
            <plugin>
                <!-- The shaded JAR keeps our META-INF/LICENSE and NOTICE, so the license and notice
                     files of the bundled libraries go to META-INF/third-party/<artifact>/. -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>third-party-notices</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>unpack-dependencies</goal>
                        </goals>
                        <configuration>
                            <includeScope>runtime</includeScope>
                            <excludeGroupIds>io.github.kamilkrzywanski</excludeGroupIds>
                            <includes>META-INF/LICENSE*,META-INF/NOTICE*</includes>
                            <outputDirectory>${project.build.outputDirectory}/META-INF/third-party</outputDirectory>
                            <useSubDirectoryPerArtifact>true</useSubDirectoryPerArtifact>
                            <stripVersion>true</stripVersion>
                            <overWriteReleases>true</overWriteReleases>
                            <fileMappers>
                                <org.codehaus.plexus.components.io.filemappers.FlattenFileMapper/>
                            </fileMappers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>io.github.kamilkrzywanski.ocr.cli.Cli</mainClass>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>

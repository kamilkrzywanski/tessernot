<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.kamilkrzywanski</groupId>
    <artifactId>tessernot-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>tessernot-parent</name>
    <description>Pure Java PP-OCR engine. No native libraries.</description>
    <url>https://github.com/kamilkrzywanski/tessernot</url>
    <inceptionYear>2026</inceptionYear>

    <modules>
        <module>tessernot</module>
        <module>tessernot-pdf</module>
        <module>tessernot-models</module>
        <module>tessernot-models-pl</module>
        <module>tessernot-cli</module>
    </modules>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>kamilkrzywanski</id>
            <name>Kamil Krzywański</name>
            <url>https://github.com/kamilkrzywanski</url>
        </developer>
    </developers>

    <scm>
        <url>https://github.com/kamilkrzywanski/tessernot</url>
        <connection>scm:git:https://github.com/kamilkrzywanski/tessernot.git</connection>
        <developerConnection>scm:git:git@github.com:kamilkrzywanski/tessernot.git</developerConnection>
    </scm>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>21</maven.compiler.release>
        <junit.version>5.11.4</junit.version>
        <pdfbox.version>3.0.5</pdfbox.version>
        <!-- Every module is one level below this POM: the repository root holds models/ and the tests read it. -->
        <repository.root>${project.basedir}/..</repository.root>
        <!-- The test JVM runs the Vector API kernels. Empty, it runs the scalar ones. -->
        <test.jvm.modules>--add-modules jdk.incubator.vector</test.jvm.modules>
        <!-- 12 CPUs for the tests: every engine sizes its pool from availableProcessors(), and a
             24-thread machine became unresponsive during a full test run. The flag sets the count,
             it does not cap it: a smaller machine should run the tests with -Dtest.jvm.cpus= -->
        <test.jvm.cpus>-XX:ActiveProcessorCount=12</test.jvm.cpus>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.github.kamilkrzywanski</groupId>
                <artifactId>tessernot</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.kamilkrzywanski</groupId>
                <artifactId>tessernot-pdf</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.kamilkrzywanski</groupId>
                <artifactId>tessernot-models</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.kamilkrzywanski</groupId>
                <artifactId>tessernot-models-pl</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.pdfbox</groupId>
                <artifactId>pdfbox</artifactId>
                <version>${pdfbox.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>${repository.root}</directory>
                <targetPath>META-INF</targetPath>
                <includes>
                    <include>LICENSE</include>
                    <include>NOTICE</include>
                </includes>
            </resource>
        </resources>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.13.0</version>
                    <configuration>
                        <release>21</release>
                        <compilerArgs>
                            <arg>--add-modules</arg>
                            <arg>jdk.incubator.vector</arg>
                        </compilerArgs>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.5.2</version>
                    <configuration>
                        <!-- Two properties, so a run can change them: -Dtest.jvm.modules= tests the scalar
                             kernels, -Dtest.jvm.cpus= uses the processors the machine has. -->
                        <argLine>${test.jvm.modules} ${test.jvm.cpus}</argLine>
                        <!-- Tests read models/ from the repository root and skip when it is missing. -->
                        <workingDirectory>${repository.root}</workingDirectory>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-dependency-plugin</artifactId>
                    <version>3.8.1</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-shade-plugin</artifactId>
                    <version>3.6.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>3.4.2</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-source-plugin</artifactId>
                    <version>3.3.1</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-gpg-plugin</artifactId>
                    <version>3.2.8</version>
                </plugin>
                <plugin>
                    <groupId>org.sonatype.central</groupId>
                    <artifactId>central-publishing-maven-plugin</artifactId>
                    <version>0.11.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-javadoc-plugin</artifactId>
                    <version>3.11.2</version>
                    <configuration>
                        <!-- VectorKernels imports the incubator module; javadoc needs it in the module graph. -->
                        <additionalOptions>
                            <additionalOption>--add-modules</additionalOption>
                            <additionalOption>jdk.incubator.vector</additionalOption>
                        </additionalOptions>
                        <excludePackageNames>io.github.kamilkrzywanski.ocr.internal.*</excludePackageNames>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-enforcer-plugin</artifactId>
                    <version>3.6.3</version>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <!-- An older JDK or Maven fails at the start with a sentence, not in the compiler. ./mvnw brings the right Maven. -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-build-tools</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[21,)</version>
                                    <message>tessernot builds with Java 21 or newer. Point JAVA_HOME at one.</message>
                                </requireJavaVersion>
                                <requireMavenVersion>
                                    <version>[3.9,)</version>
                                    <message>tessernot builds with Maven 3.9 or newer. ./mvnw downloads it.</message>
                                </requireMavenVersion>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <!--
                mvn -Prelease deploy: sources and javadoc JARs, GPG signatures, and an upload to the
                Maven Central Portal under the server id "central" of settings.xml (a portal user
                token). The deployment waits in the portal until it is published there by hand.
                tessernot-cli is uploaded as a plain JAR with its dependencies in the POM, for JBang;
                its runnable JAR with everything inside goes to GitHub Releases.
                mvn -Prelease -Dgpg.skip package builds the JARs without signing.
            -->
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals>
                                    <goal>jar-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <autoPublish>false</autoPublish>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>

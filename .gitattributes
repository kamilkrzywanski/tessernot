# The Windows wrapper script needs CRLF line ends, the shell scripts LF, whatever core.autocrlf says.
*.cmd text eol=crlf
/mvnw text eol=lf
*.sh text eol=lf
# Test fixtures are read line by line: the same bytes on every system.
*.tsv text eol=lf
# Model files are checked by SHA-256: no line-end conversion on any system.
/models/** -text
